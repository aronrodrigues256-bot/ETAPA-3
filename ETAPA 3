
#include <iostream>
#include <string>
#include <iomanip>
#include <fstream>
#include <cstdlib>

using namespace std;

const int MAX_CONTAS = 100;
const int MAX_MOVIMENTACOES = 500;

// Arrays das contas
int numeroConta[MAX_CONTAS];
string nomeCliente[MAX_CONTAS];
string cpf[MAX_CONTAS];
int tipoConta[MAX_CONTAS];
double saldo[MAX_CONTAS];
bool contaAtiva[MAX_CONTAS];

int quantidadeContas = 0;

// Arrays das movimentacoes
int contaMovimentacao[MAX_MOVIMENTACOES];
char tipoMovimentacao[MAX_MOVIMENTACOES];
double valorMovimentacao[MAX_MOVIMENTACOES];

int quantidadeMovimentacoes = 0;

// Carrega as contas do arquivo
void carregarContas() {
    ifstream arquivo("contas.txt");

    if (arquivo.is_open()) {
        string numero, nome, documento, tipo, valor, situacao;

        while (getline(arquivo, numero, ';')) {
            getline(arquivo, nome, ';');
            getline(arquivo, documento, ';');
            getline(arquivo, tipo, ';');
            getline(arquivo, valor, ';');
            getline(arquivo, situacao);

            if (quantidadeContas < MAX_CONTAS) {
                numeroConta[quantidadeContas] = atoi(numero.c_str());
                nomeCliente[quantidadeContas] = nome;
                cpf[quantidadeContas] = documento;
                tipoConta[quantidadeContas] = atoi(tipo.c_str());
                saldo[quantidadeContas] = atof(valor.c_str());
                contaAtiva[quantidadeContas] = atoi(situacao.c_str());

                quantidadeContas++;
            }
        }

        arquivo.close();
    }
}

// Salva as contas no arquivo
void salvarContas() {
    ofstream arquivo("contas.txt");

    if (arquivo.is_open()) {
        for (int i = 0; i < quantidadeContas; i++) {
            arquivo << numeroConta[i] << ";"
                    << nomeCliente[i] << ";"
                    << cpf[i] << ";"
                    << tipoConta[i] << ";"
                    << saldo[i] << ";"
                    << contaAtiva[i] << endl;
        }

        arquivo.close();
    }
}

// Carrega as movimentacoes
void carregarMovimentacoes() {
    ifstream arquivo("movimentacoes.txt");

    if (arquivo.is_open()) {
        string conta, tipo, valor;

        while (getline(arquivo, conta, ';')) {
            getline(arquivo, tipo, ';');
            getline(arquivo, valor);

            if (quantidadeMovimentacoes < MAX_MOVIMENTACOES) {
                contaMovimentacao[quantidadeMovimentacoes] = atoi(conta.c_str());
                tipoMovimentacao[quantidadeMovimentacoes] = tipo[0];
                valorMovimentacao[quantidadeMovimentacoes] = atof(valor.c_str());

                quantidadeMovimentacoes++;
            }
        }

        arquivo.close();
    }
}

// Salva as movimentacoes
void salvarMovimentacoes() {
    ofstream arquivo("movimentacoes.txt");

    if (arquivo.is_open()) {
        for (int i = 0; i < quantidadeMovimentacoes; i++) {
            arquivo << contaMovimentacao[i] << ";"
                    << tipoMovimentacao[i] << ";"
                    << valorMovimentacao[i] << endl;
        }

        arquivo.close();
    }
}

int main() {

    int opcao;

    cout << fixed << setprecision(2);

    carregarContas();
    carregarMovimentacoes();

    do {

        cout << "\n********************************" << endl;
        cout << "          BANCO INF101" << endl;
        cout << "********************************" << endl;

        cout << "1 - Cadastrar conta" << endl;
        cout << "2 - Listar contas" << endl;
        cout << "3 - Consultar conta" << endl;
        cout << "4 - Realizar deposito" << endl;
        cout << "5 - Realizar saque" << endl;
        cout << "6 - Realizar transferencia" << endl;
        cout << "7 - Exibir extrato" << endl;
        cout << "8 - Alterar tipo da conta" << endl;
        cout << "9 - Ativar/Desativar conta" << endl;
        cout << "10 - Sair" << endl;

        cout << "\nEscolha uma opcao: ";
        cin >> opcao;

        switch (opcao) {

            case 1: {

                if (quantidadeContas >= MAX_CONTAS) {
                    cout << "Limite de contas atingido!" << endl;
                    break;
                }

                int numero;
                bool existe = false;

                cout << "\nDigite o numero da conta: ";
                cin >> numero;

                if (numero <= 0) {
                    cout << "Numero invalido!" << endl;
                    break;
                }

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        existe = true;
                    }
                }

                if (existe) {
                    cout << "Essa conta ja esta cadastrada!" << endl;
                    break;
                }

                numeroConta[quantidadeContas] = numero;

                cin.ignore();

                cout << "Nome do cliente: ";
                getline(cin, nomeCliente[quantidadeContas]);

                cout << "CPF do cliente: ";
                getline(cin, cpf[quantidadeContas]);

                cout << "Tipo (1 - Corrente / 2 - Poupanca): ";
                cin >> tipoConta[quantidadeContas];

                if (tipoConta[quantidadeContas] != 1 &&
                    tipoConta[quantidadeContas] != 2) {
                    cout << "Tipo invalido!" << endl;
                    break;
                }

                cout << "Saldo inicial: R$ ";
                cin >> saldo[quantidadeContas];

                if (saldo[quantidadeContas] < 0) {
                    cout << "Saldo nao pode ser negativo!" << endl;
                    break;
                }

                contaAtiva[quantidadeContas] = true;

                quantidadeContas++;

                salvarContas();

                cout << "Conta cadastrada com sucesso!" << endl;

                break;
            }

            case 2: {

                if (quantidadeContas == 0) {
                    cout << "Nenhuma conta cadastrada!" << endl;
                    break;
                }

                cout << "\n====== CONTAS CADASTRADAS ======" << endl;

                for (int i = 0; i < quantidadeContas; i++) {

                    cout << "\nNumero: " << numeroConta[i] << endl;
                    cout << "Cliente: " << nomeCliente[i] << endl;
                    cout << "CPF: " << cpf[i] << endl;

                    if (tipoConta[i] == 1) {
                        cout << "Tipo: Corrente" << endl;
                    } else {
                        cout << "Tipo: Poupanca" << endl;
                    }

                    cout << "Saldo: R$ " << saldo[i] << endl;

                    if (contaAtiva[i]) {
                        cout << "Situacao: Ativa" << endl;
                    } else {
                        cout << "Situacao: Desativada" << endl;
                    }
                }

                break;
            }

            case 3: {

                int numero;
                int indice = -1;

                cout << "Digite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                } else {

                    cout << "\n====== DADOS DA CONTA ======" << endl;
                    cout << "Numero: " << numeroConta[indice] << endl;
                    cout << "Cliente: " << nomeCliente[indice] << endl;
                    cout << "CPF: " << cpf[indice] << endl;
                    cout << "Saldo: R$ " << saldo[indice] << endl;

                    if (tipoConta[indice] == 1) {
                        cout << "Tipo: Corrente" << endl;
                    } else {
                        cout << "Tipo: Poupanca" << endl;
                    }

                    if (contaAtiva[indice]) {
                        cout << "Situacao: Ativa" << endl;
                    } else {
                        cout << "Situacao: Desativada" << endl;
                    }
                }

                break;
            }

            case 4: {

                int numero;
                int indice = -1;
                double valor;

                cout << "Digite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                if (!contaAtiva[indice]) {
                    cout << "Conta desativada!" << endl;
                    break;
                }

                if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                    cout << "Historico cheio!" << endl;
                    break;
                }

                cout << "Valor do deposito: R$ ";
                cin >> valor;

                if (valor <= 0) {
                    cout << "Valor invalido!" << endl;
                    break;
                }

                saldo[indice] = saldo[indice] + valor;

                contaMovimentacao[quantidadeMovimentacoes] = numero;
                tipoMovimentacao[quantidadeMovimentacoes] = 'D';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                salvarContas();
                salvarMovimentacoes();

                cout << "Deposito realizado!" << endl;
                cout << "Novo saldo: R$ " << saldo[indice] << endl;

                break;
            }

            case 5: {

                int numero;
                int indice = -1;
                double valor;

                cout << "Digite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                if (!contaAtiva[indice]) {
                    cout << "Conta desativada!" << endl;
                    break;
                }

                if (quantidadeMovimentacoes >= MAX_MOVIMENTACOES) {
                    cout << "Historico cheio!" << endl;
                    break;
                }

                cout << "Valor do saque: R$ ";
                cin >> valor;

                if (valor <= 0) {
                    cout << "Valor invalido!" << endl;
                    break;
                }

                if (valor > saldo[indice]) {
                    cout << "Saldo insuficiente!" << endl;
                    break;
                }

                saldo[indice] = saldo[indice] - valor;

                contaMovimentacao[quantidadeMovimentacoes] = numero;
                tipoMovimentacao[quantidadeMovimentacoes] = 'S';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                salvarContas();
                salvarMovimentacoes();

                cout << "Saque realizado!" << endl;
                cout << "Novo saldo: R$ " << saldo[indice] << endl;

                break;
            }

            case 6: {

                int origem, destino;
                int indiceOrigem = -1;
                int indiceDestino = -1;
                double valor;

                cout << "Conta de origem: ";
                cin >> origem;

                cout << "Conta de destino: ";
                cin >> destino;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == origem) {
                        indiceOrigem = i;
                    }

                    if (numeroConta[i] == destino) {
                        indiceDestino = i;
                    }
                }

                if (indiceOrigem == -1 || indiceDestino == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                if (indiceOrigem == indiceDestino) {
                    cout << "Contas devem ser diferentes!" << endl;
                    break;
                }

                if (!contaAtiva[indiceOrigem] ||
                    !contaAtiva[indiceDestino]) {
                    cout << "Uma das contas esta desativada!" << endl;
                    break;
                }

                if (quantidadeMovimentacoes + 2 > MAX_MOVIMENTACOES) {
                    cout << "Historico cheio!" << endl;
                    break;
                }

                cout << "Valor da transferencia: R$ ";
                cin >> valor;

                if (valor <= 0) {
                    cout << "Valor invalido!" << endl;
                    break;
                }

                if (valor > saldo[indiceOrigem]) {
                    cout << "Saldo insuficiente!" << endl;
                    break;
                }

                saldo[indiceOrigem] = saldo[indiceOrigem] - valor;
                saldo[indiceDestino] = saldo[indiceDestino] + valor;

                contaMovimentacao[quantidadeMovimentacoes] = origem;
                tipoMovimentacao[quantidadeMovimentacoes] = 'S';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                contaMovimentacao[quantidadeMovimentacoes] = destino;
                tipoMovimentacao[quantidadeMovimentacoes] = 'D';
                valorMovimentacao[quantidadeMovimentacoes] = valor;

                quantidadeMovimentacoes++;

                salvarContas();
                salvarMovimentacoes();

                cout << "Transferencia realizada!" << endl;

                break;
            }

            case 7: {

                int numero;
                int indice = -1;

                cout << "Digite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                cout << "\n====== EXTRATO BANCARIO ======" << endl;
                cout << "Cliente: " << nomeCliente[indice] << endl;
                cout << "Conta: " << numeroConta[indice] << endl;

                bool encontrou = false;

                for (int i = 0; i < quantidadeMovimentacoes; i++) {
                    if (contaMovimentacao[i] == numero) {
                        encontrou = true;

                        if (tipoMovimentacao[i] == 'D') {
                            cout << "Deposito/Entrada: R$ "
                                 << valorMovimentacao[i] << endl;
                        } else {
                            cout << "Saque/Saida: R$ "
                                 << valorMovimentacao[i] << endl;
                        }
                    }
                }

                if (!encontrou) {
                    cout << "Nenhuma movimentacao registrada." << endl;
                }

                cout << "Saldo atual: R$ " << saldo[indice] << endl;

                break;
            }

            case 8: {

                int numero;
                int indice = -1;
                int novoTipo;

                cout << "Digite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                cout << "Novo tipo (1 - Corrente / 2 - Poupanca): ";
                cin >> novoTipo;

                if (novoTipo != 1 && novoTipo != 2) {
                    cout << "Tipo invalido!" << endl;
                    break;
                }

                tipoConta[indice] = novoTipo;

                salvarContas();

                cout << "Tipo alterado com sucesso!" << endl;

                break;
            }

            case 9: {

                int numero;
                int indice = -1;

                cout << "Digite o numero da conta: ";
                cin >> numero;

                for (int i = 0; i < quantidadeContas; i++) {
                    if (numeroConta[i] == numero) {
                        indice = i;
                    }
                }

                if (indice == -1) {
                    cout << "Conta nao encontrada!" << endl;
                    break;
                }

                contaAtiva[indice] = !contaAtiva[indice];

                salvarContas();

                if (contaAtiva[indice]) {
                    cout << "Conta ativada!" << endl;
                } else {
                    cout << "Conta desativada!" << endl;
                }

                break;
            }

            case 10:
                cout << "Encerrando o Banco INF101..." << endl;
                break;

            default:
                cout << "Opcao invalida!" << endl;
        }

    } while (opcao != 10);

    return 0;
}
